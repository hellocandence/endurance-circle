# Copy to .env.local and fill in. Never commit real values.

# Postgres connection (Render internal URL in production).
# Leave unset in dev to use the embedded PGlite database in .data/ (production requires it).
# DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=
# Public app URL. In production this must be the https URL (login cookies and emailed links use it)
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email: Brevo (free, no domain needed: verify a single sender) or Resend (needs a verified domain). Brevo wins if both are set.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Cadence <no-reply@example.com>

# Bootstraps the owner account
OWNER_EMAIL=owner@example.com
