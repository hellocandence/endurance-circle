# Copy to .env.local and fill in. Never commit real values.

# Postgres connection (Render internal URL in production).
# Leave unset in dev to use the embedded PGlite database in .data/ (production requires it).
# DATABASE_URL=postgres://endurance_circle:endurance_circle@localhost:5432/endurance_circle

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=
# Public app URL. In production this must be the https URL (login cookies and emailed links use it)
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email, first one configured wins:
#  1. Gmail API over HTTPS (works on Render free, which blocks SMTP ports): create a Google "Desktop app" OAuth client with the
#     Gmail API enabled, put its id/secret here, then run `pnpm gmail:token` once to get GMAIL_REFRESH_TOKEN.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
#  2. Gmail/SMTP with an app password (blocked on Render free), 3. Brevo or Resend (both need your own domain).
# Gmail: turn on 2-step verification, create an App password, use your Gmail address as SMTP_USER and in EMAIL_FROM.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Endurance Circle <no-reply@example.com>

# EC AI (WhatsApp reminders through Misa AI). EC_CRON_SECRET: >= 16 random chars; an external cron POSTs /api/ec/tick every 5 min with header x-cron-secret.
EC_CRON_SECRET=
# Misa AI base URL and its CRON_SECRET (Misa's /ec/send)
MISA_URL=
MISA_SECRET=

# Bootstraps the owner account
OWNER_EMAIL=owner@example.com
