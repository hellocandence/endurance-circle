# Copy to .env.local and fill in. Never commit real values.

# Postgres connection (Render internal URL in production).
# Leave unset in dev to use the embedded PGlite database in .data/ (production requires it).
# DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET=
# Public app URL. In production this must be the https URL (login cookies and emailed links use it)
AUTH_URL=http://localhost:3000

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email, first one configured wins: Gmail/SMTP (app password, no domain), then Brevo or Resend (both need your own domain).
# Gmail: turn on 2-step verification, create an App password, use your Gmail address as SMTP_USER and in EMAIL_FROM.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=Cadence <no-reply@example.com>

# Bootstraps the owner account
OWNER_EMAIL=owner@example.com
